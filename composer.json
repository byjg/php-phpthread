{
  "name": "byjg/phpthread",
  "description": "ByJG PHPThread simplifies working with threads and non-blocking code in PHP, bridging the gap for a language that was not inherently designed for threading.",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "byjg/cache-engine": "^7.0",
    "ext-pcntl": "*",
    "ext-posix": "*",
    "php": ">=8.3 <8.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",

    "react/promise": "^3.2",
    "react/event-loop": "^1.5",
    "byjg/restserver": "^7.0",
    "psalm/phar": "^6.16"
  },
  "suggest": {
    "ext-pthreads": "*"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "ByJG\\PHPThread\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": "vendor/bin/psalm.phar"
  }
}
